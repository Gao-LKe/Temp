<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MintTwoCol</AssemblyName>
    <RootNamespace>MintTwoCol</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\..\LocalPaths.props" Condition="Exists('..\..\..\LocalPaths.props')" />

  <PropertyGroup>
    <RimWorldDir Condition="'$(RimWorldDir)'==''">F:\SteamLibrary\steamapps\common\RimWorld</RimWorldDir>
    <HarmonyDir Condition="'$(HarmonyDir)'==''">F:\SteamLibrary\steamapps\workshop\content\294100\2009463077</HarmonyDir>
    <MintDir Condition="'$(MintDir)'==''">F:\SteamLibrary\steamapps\workshop\content\294100\1446523594</MintDir>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\1.7\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DubsMintMenus">
      <HintPath>$(MintDir)\1.7\Assemblies\DubsMintMenus.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
