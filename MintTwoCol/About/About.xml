<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
    <name>Mint Two Columns</name>
    <author>GK</author>
    <packageId>gk.minttwocol</packageId>
    <description>把 Dubs Mint Menus 建筑窗口左侧的分类栏拆成左右两栏：左栏放核心与官方 DLC 分类，右栏放其他 Mod 新增的分类，中间建筑网格与信息卡保持原位。两栏内的分类行可拖拽调整顺序，顺序自动保存。需要 Harmony 与 Dubs Mint Menus。可选：订阅并启用「拼音搜索 Pinyin Quick Search」（steam://url/CommunityFilePage/3244870513）后，建筑搜索框额外支持全拼与首字母拼音，未启用不影响其他功能。

[AI 辅助生成]</description>
    <supportedVersions>
        <li>1.7</li>
    </supportedVersions>
    <modDependencies>
        <li>
            <packageId>brrainz.harmony</packageId>
            <displayName>Harmony</displayName>
            <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
            <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
        </li>
        <li>
            <packageId>Dubwise.DubsMintMenus</packageId>
            <displayName>Dubs Mint Menus</displayName>
            <steamWorkshopUrl>steam://url/CommunityFilePage/1446523594</steamWorkshopUrl>
        </li>
    </modDependencies>
    <loadAfter>
        <li>Ludeon.RimWorld</li>
        <li>brrainz.harmony</li>
        <li>Dubwise.DubsMintMenus</li>
        <li>cedaro.PinyinQuickSearch</li>
    </loadAfter>
</ModMetaData>
